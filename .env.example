# LLM providers
GROQ_API_KEY=
GOOGLE_API_KEY=

# Set true for e2e/smoke runs: forces the offline simulated client even when
# provider keys are present, so no real provider quota is spent (D-035).
DRIFTWATCH_FORCE_SIMULATED=false

# Monitor service
DRIFTWATCH_DB_PATH=./data/driftwatch.sqlite3
DRIFTWATCH_ALERT_THRESHOLD=0.17
DRIFTWATCH_CANARY_INTERVAL_MINUTES=15

# Rate limiting
DRIFTWATCH_RATE_LIMIT_PER_SESSION=30/minute
DRIFTWATCH_DAILY_QUOTA=500

# Frontend (Next.js)
NEXT_PUBLIC_MONITOR_API_URL=http://localhost:8000

# Cloud control plane (Spec_Upgrade.md section 6.5) - optional. Local-only
# mode works with all of these unset. Never commit real values here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
