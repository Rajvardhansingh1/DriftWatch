# ---------------------------------------------------------------------------
# DriftWatch .gitignore
# Rule of thumb: nothing that holds a secret, a local path, a build output or
# runtime data belongs in git. If a pattern here ever stops matching a file you
# need, fix the pattern; do not force-add the file.
# ---------------------------------------------------------------------------

# --- Secrets and local environment ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.yaml
# Local tooling config: points assistants at a Supabase project, and local
# permission settings can hold tokens.
.mcp.json
.claude/
# A folder linked with `driftwatch init` (project id only). Stays on the machine.
.driftwatch/

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg
*.egg-info/
.eggs/
dist/
build/
wheelhouse/
*.whl

# --- Test, coverage and lint output ----------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.playwright-cli/
playwright-report/
test-results/

# --- Node / Next.js (frontend) ---------------------------------------------
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Runtime data, databases and reports ------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
eval_reports/
data/baseline_embeddings/
data/canary_probes/
data/synthetic_degradation/
logs/
*.log

# --- Local planning and scratch (kept out of the public repo) ---------------
# Docs/ holds specs, plans and decision logs. It is NOT backed up by git: copy
# it somewhere safe (a private repo, cloud drive) if you change machines.
Docs/
.superpowers/

# --- OS and editors ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
